#!/bin/sh /etc/rc.common

START=15
STOP=85
USE_PROCD=1

start_service()
{
	local enabled mode verify_platform interval hysteresis curve

	config_load nomadix-platform
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get mode main mode full
	config_get_bool verify_platform main verify_platform 1
	config_get interval main interval 2
	config_get hysteresis main hysteresis 2000
	config_get curve main curve

	case "$mode" in
	full)
		;;
	curve)
		[ -n "$curve" ] || {
			logger -t nomadix-platform "temperature curve is empty"
			return 1
		}
		;;
	*)
		logger -t nomadix-platform "invalid fan mode: $mode"
		return 1
		;;
	esac

	modprobe w83627ehf || {
		logger -t nomadix-platform "failed to load w83627ehf"
		return 1
	}
	if [ "$mode" = curve ]; then
		modprobe coretemp ||
			logger -t nomadix-platform \
				"failed to load coretemp; daemon will force PWM 255"
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/nomadix-fand
	procd_append_param command -i "$interval"
	if [ "$mode" = full ]; then
		procd_append_param command -F
	else
		procd_append_param command -y "$hysteresis" -c "$curve"
	fi
	[ "$verify_platform" -eq 1 ] || procd_append_param command -S
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_close_instance
}

service_triggers()
{
	procd_add_reload_trigger nomadix-platform
}

reload_service()
{
	stop
	start
}
